# Copy to .env and fill in. Never commit .env.
# Supabase (Phase 1 — live deals, auth, shared lists)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Stripe (grocer portal billing; server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional analytics (index.html)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
# Instacart Developer Platform (server-side only): "Send your list to Instacart" carries the items when a key is set.
# Get a development key at https://docs.instacart.com/developer_platform_api/ ; set INSTACART_ENV=production with a production key.
INSTACART_API_KEY=
INSTACART_ENV=development
# API port for `pnpm dev:server` / `pnpm start`
PORT=3001
